<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventory Management</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 30px;
            background: #f4f6f9;
            color: #222;
        }

        .container {
            max-width: 1100px;
            margin: auto;
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
        }

        h1 {
            color: #203b33;
        }

        .back {
            color: #203b33;
            text-decoration: none;
        }

        .table-wrapper {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            padding: 13px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        th {
            background: #203b33;
            color: white;
        }

        .available {
            color: #218838;
            font-weight: bold;
        }

        .low {
            color: #b77900;
            font-weight: bold;
        }

        .out {
            color: #c82333;
            font-weight: bold;
        }

        .row-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        button {
            padding: 0;
            border: 0;
            background: none;
            color: #203b33;
            font: inherit;
            text-decoration: underline;
            cursor: pointer;
        }

        .message {
            padding: 10px 12px;
            border-left: 4px solid #218838;
            background: #edf6ef;
        }

        .error {
            border-color: #c82333;
            background: #fff0f1;
        }

        @media (max-width: 700px) {
            body {
                padding: 10px;
            }

            .container {
                padding: 15px;
            }

            table {
                min-width: 650px;
            }
        }
    </style>
</head>

<body>
<div class="container">

    <a class="back" href="/dashboard">← Back to Dashboard</a>

    <h1>Inventory Management</h1>
    <p>Monitor stock quantities and resource availability.</p>
    <p class="message" th:if="${successMessage}" th:text="${successMessage}"></p>
    <p class="message error" th:if="${errorMessage}" th:text="${errorMessage}"></p>
    <p><a href="/inventory/new">Add Item</a></p>

    <div class="table-wrapper">
        <table>
            <thead>
            <tr>
                <th>ID</th>
                <th>Item Code</th>
                <th>Item Name</th>
                <th>Category</th>
                <th>Quantity</th>
                <th>Unit</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
            </thead>

            <tbody>
            <tr th:each="item : ${inventoryItems}">
                <td th:text="${item.id}"></td>
                <td th:text="${item.itemCode}"></td>
                <td th:text="${item.itemName}"></td>
                <td th:text="${item.category}"></td>
                <td th:text="${item.quantity}"></td>
                <td th:text="${item.unit}"></td>
                <td>
                    <span
                        th:text="${item.status}"
                        th:class="${item.quantity == 0 ? 'out' :
                            (item.quantity <= 10 ? 'low' : 'available')}">
                    </span>
                </td>
                <td>
                    <div class="row-actions">
                        <a th:href="@{/inventory/edit/{id}(id=${item.id})}">Edit</a>
                        <form th:action="@{/inventory/delete/{id}(id=${item.id})}"
                              method="post">
                            <button type="submit">Delete</button>
                        </form>
                    </div>
                </td>
            </tr>

            <tr th:if="${#lists.isEmpty(inventoryItems)}">
                <td colspan="8">No inventory items available.</td>
            </tr>
            </tbody>
        </table>
    </div>

</div>
</body>
</html>